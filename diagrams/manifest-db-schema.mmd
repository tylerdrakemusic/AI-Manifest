erDiagram
    BRIEFS ||--o{ BRIEF_AUDIO : has
    BRIEFS {
        text brief_id PK
        text title
        text source_topic
        text content_md
        text generated_at
    }
    BRIEF_AUDIO {
        integer id PK
        text brief_id FK
        text voice_id
        text mp3_path
        real duration_sec
    }
    VOICES {
        text voice_id PK
        text label
        text provider
    }
    TODOS ||--o{ PRIORITY_HISTORY : has
    TODOS ||--|| TODO_DECISION_METADATA : current
    TODOS ||--o{ TODO_DECISION_ASSESSMENTS : history
    TODOS ||--o{ TODOS : parent_of
    TODOS ||--o{ TODO_PREREQUISITES : dependent
    TODOS ||--o{ TODO_PREREQUISITES : prerequisite
    TODOS ||--o{ TODO_FR_LINKS : links
    TODOS ||--o{ TODO_BATCH_OPERATIONS : records
    FR_LEDGER ||--o{ TODO_FR_LINKS : "confirmed logical link"
    TODOS {
        integer id PK
        text project
        text source "AI|TYLER|SCAN"
        text text
        integer done
        text created_at
        text closed_at
        text closure_reason "nullable — completed|cancelled|stale; legacy rows remain NULL after migration"
        integer priority "default 5"
        text autonomy_level "full|supervised|human"
        text fr_id "nullable — links to active FR"
        text perfected_at "nullable — UTC timestamp proving successful approved perfect-scoped-td refinement; independent of fr_id"
        text rationale "nullable — LLM-generated rationale"
        text implementation_hints "nullable — LLM-generated hints"
        text context_snapshot "nullable — project context at discovery"
        text estimated_effort "nullable — XS|S|M|L|XL"
        text dependencies "nullable — todo IDs / FR IDs (comma-sep)"
        integer parent_id "nullable — logical parent todo self-reference; no DB FK"
        text updated_at "UTC optimistic-concurrency version"
    }
    TODO_PREREQUISITES {
        integer todo_id PK, FK
        integer prerequisite_id PK, FK
        text allowed_terminal_states "default completed|cancelled|stale; prerequisite must reach one"
        text created_at
        text constraint "todo_id <> prerequisite_id; cycles rejected"
    }
    TODO_FR_LINKS {
        integer todo_id PK, FK
        text fr_id PK "canonical FR ID; confirmation required"
        integer confirmed "default 0; CHECK 0|1"
        text created_at
    }
    FR_LEDGER {
        text fr_id PK "canonical feature-request registry; logical reference"
    }
    PRIORITY_HISTORY {
        integer id PK
        integer todo_id FK
        integer priority
        text scored_at
    }
    TODO_DECISION_METADATA {
        integer todo_id PK, FK
        text expected_value
        text user_or_system_benefit
        text strategic_alignment
        integer confidence "1-10"
        text cost_of_delay
        text primary_benefit_category
        text secondary_benefit_category
        text benefit_summary
        text justification
        text evidence "JSON list"
        text assessed_by
        text updated_at
    }
    TODO_DECISION_ASSESSMENTS {
        integer id PK
        integer todo_id FK
        text expected_value
        text user_or_system_benefit
        text strategic_alignment
        integer confidence "1-10"
        text cost_of_delay
        text primary_benefit_category
        text secondary_benefit_category
        text benefit_summary
        text justification
        text evidence "JSON list"
        text assessed_by
        text assessed_at
    }
    TODO_BATCH_OPERATIONS {
        text idempotency_key PK
        integer parent_id FK
        text child_ids "JSON replay payload"
        text request_payload "nullable JSON input payload for idempotency validation"
        text created_at
    }
    TTS_QUEUE ||--o{ TTS_QUEUE_RECOVERIES : recovery
    TTS_QUEUE {
        integer id PK
        text text
        text voice_id
        text status "PENDING|IN_PROGRESS|DONE|FAILED"
        integer retry_count
        text started_at "lease timestamp"
        text output_path
        text decision_id "nullable; partial unique deduplication index idx_tts_queue_decision_id"
    }
    TTS_QUEUE_RECOVERIES {
        integer id PK
        integer job_id FK
        text recovered_at
        text previous_started_at
        integer retry_count
        text reason
    }

