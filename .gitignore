# 👁AI-Manifest .gitignore
# FR-20260422-gitignore-sweep

# Audio
*.wav
*.mp3
*.flac
*.aif
*.aiff
*.m4a
*.ogg

# Video
*.mp4
*.mov
*.avi
*.mkv

# Large ML model weights (never commit these)
*.bin
*.safetensors
*.gguf
*.pt
*.ckpt
*.pth

# Generated output
output/*.mp3
output/*.wav
output/*.ogg

# Binaries / executables
*.exe
*.dll

# Large image/raw formats
*.heic
*.psd
*.raw

# Databases (SQLite / SQLCipher)
src/data/*.db
src/data/*.db-shm
src/data/*.db-wal
*.sqlite
*.sqlite3

# Python
*.pyc
*.pyo
*.pyd
*.py[cod]
.Python
__pycache__/
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# Logs
*.log
logs/*.log

# Temp / cache
*.download

# Environment & secrets
.env
.env.local
.venv/
*.key
*.pem
secrets.*

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
