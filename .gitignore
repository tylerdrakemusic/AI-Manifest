# 👁AI-Manifest .gitignore
# FR-20260422-gitignore-sweep

# Audio
*.wav
*.mp3
*.flac
*.aif
*.aiff
*.m4a
*.ogg

# Video
*.mp4
*.mov
*.avi
*.mkv

# Large ML model weights (never commit these)
*.bin
*.safetensors
*.gguf
*.pt
*.ckpt
*.pth

# Generated output
output/*.mp3
output/*.wav
output/*.ogg
output/images/
output/executive_brief_portal.html
output/report.txt

# Binaries / executables
*.exe
*.dll

# Large image/raw formats
*.heic
*.psd
*.raw

# Databases (SQLite / SQLCipher)
src/data/*.db
# lily_config.db is covered by the glob above — never commit it (seed via tools/lily/seed_lily_config.py)
# src/data/lily_config.db  <-- already ignored by src/data/*.db
# manifest_todos.db is a live runtime DB — never commit (seed via tools/ scripts)
src/data/*.db-shm
src/data/*.db-wal
*.sqlite
*.sqlite3

# Python
*.pyc
*.pyo
*.pyd
*.py[cod]
.Python
__pycache__/
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# Logs
*.log
logs/*.log

# Temp / cache
*.download
tmp/

# Environment & secrets
.env
.env.local
.venv/
*.key
*.pem
secrets.*

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# FR-20260423-sibling-gitignore-parity
.playwright-mcp/
src/data/*.db-journal
src/data/backups/
*.tmp


# FR-20260423-sibling-gitignore-parity
.playwright-mcp/
src/data/*.db-journal
src/data/backups/
*.tmp

brief_log.txt
output/report.txt

# Proof / QA screenshots (ephemeral QA artifacts — not committed to git)
proof/
proof/**/*.png
proof/**/*.jpg
proof/**/*.jpeg
proof/**/*.webp
proof/**/*.gif
